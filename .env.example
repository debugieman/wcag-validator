# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# Resend (https://resend.com/api-keys)
Resend__ApiKey=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe (https://dashboard.stripe.com/apikeys)
Stripe__SecretKey=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
Stripe__WebhookSecret=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL used for Stripe success/cancel redirect.
# Local dev (docker-compose.yml): http://localhost:4200
# Production (docker-compose.prod.yml, behind Caddy): your real https:// domain
App__BaseUrl=http://localhost:4200

# Allowed CORS origins for the API, comma-separated. Must match App__BaseUrl's
# origin in production, e.g.: https://wcag-analyzer.com,https://www.wcag-analyzer.com
# Only read by docker-compose.prod.yml — local dev (docker-compose.yml) relies on
# appsettings.json's localhost default instead and ignores this variable.
App__CorsOrigins=http://localhost:4200,http://localhost
